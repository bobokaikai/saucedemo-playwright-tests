	"item": [
		{
			"name": "GetProducts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\",function(){",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response 有產品 array\",function(){",
							"    const data=pm.response.json();",
							"    pm.expect(data.products).to.be.an(\"array\")",
							"})",
							"",
							"pm.test(\"每個產品含有必要欄位\",function(){",
							"    const data=pm.response.json();",
							"    pm.expect(data.products.length).to.be.greaterThan(0);",
							"    ",
							"    //檢查第一筆資料欄位",
							"    const product=data.products[0];",
							"    pm.expect(product).to.have.property(\"id\");",
							"    pm.expect(product).to.have.property(\"title\");",
							"    pm.expect(product).to.have.property(\"price\");",
							"    pm.expect(product.price).to.be.a(\"number\");",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://dummyjson.com/products",
					"protocol": "https",
					"host": [
						"dummyjson",
						"com"
					],
					"path": [
						"products"
					]
				}
			},
			"response": []
		},
